<UserControl x:Class="FaceMosaicSharp.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FaceMosaicSharp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:Button Content="选择视频" Command="{Binding SelectVideoCommand}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding VideoPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="5">
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <ui:Button Content="⛶" Command="{Binding OpenPreviewImageCommand}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Width="28" Height="28" Margin="2" Padding="0"
                                   ToolTip="使用系统图片查看器打开"
                                   Visibility="{Binding HasVideoSelected, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,10,0,0" ColumnDefinitions="*,Auto,Auto"
                      Visibility="{Binding HasVideoSelected, Converter={StaticResource BoolToVisConverter}}">
                    <CheckBox Content="预览打码" IsChecked="{Binding PreviewMosaicEnabled}" VerticalAlignment="Center" Padding="0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="帧号:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ui:NumberBox x:Name="FrameNumberBox" Value="{Binding PreviewFrameNumber, Mode=TwoWay}" 
                                      Minimum="0" Maximum="{Binding VideoInfo.TotalFrames}" 
                                      Width="130" Margin="0,0,10,0"  ClearButtonEnabled="False" PreviewKeyDown="FrameNumberBox_KeyDown"/>
                        <TextBlock Text="{Binding VideoInfo.TotalFrames, StringFormat='共 {0} 帧'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding VideoInfo.Duration, StringFormat='时长: {0:hh\\:mm\\:ss}'}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="280">
                        <ui:TextBlock Text="人脸检测方式" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <ui:TextBlock Text="检测算法" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding FaceDetectionMethods}" SelectedItem="{Binding FaceDetectionMethod}" Margin="0,0,0,5"/>

                        <ui:TextBlock Text="置信度阈值" Margin="0,10,0,5"/>
                        <Slider Value="{Binding ConfidenceThreshold}" Minimum="0.1" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding ConfidenceThreshold, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right" Margin="0,0,0,5"/>

                        <CheckBox Content="面部五官解析" IsChecked="{Binding EnableFacialFeatures}" Margin="0,5,0,5"
                                  ToolTip="开启后将解析面部关键点（左右眼、鼻尖、左右嘴角）并显示在标注帧上"/>

                        <StackPanel IsEnabled="{Binding EnableFacialFeatures}" Margin="20,0,0,5">
                            <CheckBox Content="眼睛线条打码" IsChecked="{Binding EyeLineMosaic}" Margin="0,2,0,2"/>
                            <CheckBox Content="嘴巴线条打码" IsChecked="{Binding MouthLineMosaic}" Margin="0,2,0,2"/>
                        </StackPanel>

                        <CheckBox Content="面部轮廓解析" IsChecked="{Binding EnableFaceParsing}" Margin="0,0,0,5"
                                  ToolTip="开启后使用 BiSeNet 进行像素级人面部分割，按人脸轮廓精确打马赛克（需下载模型）"/>

                        <StackPanel IsEnabled="{Binding EnableFaceParsing}">
                            <ui:TextBlock Text="轮廓覆盖率阈值" Margin="0,10,0,5"
                                          ToolTip="面部解析轮廓面积占人脸区域的比例（0.1%~50%），低于此值时回退到矩形马赛克"/>
                            <Slider Value="{Binding MaskCoverageThreshold}" Minimum="0.001" Maximum="0.5" TickFrequency="0.01" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding MaskCoverageThreshold, StringFormat='{}{0:P1}'}" HorizontalAlignment="Right" Margin="0,0,0,15"/>
                        </StackPanel>

                        <ui:TextBlock Text="马赛克设置" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,15"/>

                        <ui:TextBlock Text="块大小" Margin="0,0,0,5"/>
                        <Slider Value="{Binding MosaicBlockSize}" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding MosaicBlockSize, StringFormat='{}{0} 像素'}" HorizontalAlignment="Right" Margin="0,0,0,15"/>

                        <ui:TextBlock Text="输出设置" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,15"/>

                        <ui:TextBlock Text="格式" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}" Margin="0,0,0,15"/>

                        <ui:TextBlock Text="编码器" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding VideoCodec}" Margin="0,0,0,15"/>

                        <ui:TextBlock Text="帧率（0=保持原视频帧率）" Margin="0,0,0,5"/>
                        <ui:NumberBox Value="{Binding OutputFps}" Minimum="0" Maximum="120" Margin="0,0,0,15"/>

                        <ui:TextBlock Text="性能优化" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,15"/>

                        <CheckBox Content="处理所有帧" IsChecked="{Binding ProcessAllFrames}" Margin="0,0,0,10"/>

                        <StackPanel IsEnabled="{Binding ProcessAllFrames, Converter={StaticResource InverseBoolConverter}}">
                            <ui:TextBlock Text="帧范围" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:NumberBox Grid.Column="0" Value="{Binding StartFrame}" Minimum="0" Margin="0,0,0,10" ClearButtonEnabled="False"/>
                                <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="5,0,5,10"/>
                                <ui:NumberBox Grid.Column="2" Value="{Binding EndFrame}" Minimum="0" Margin="0,0,0,10"  ClearButtonEnabled="False"/>
                            </Grid>
                        </StackPanel>

                        <ui:TextBlock Text="检测间隔（每N帧检测一次）" Margin="0,0,0,5"/>
                        <ui:NumberBox Value="{Binding FrameInterval}" Minimum="1" Maximum="30" Margin="0,0,0,15"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="开始处理" Command="{Binding StartProcessingCommand}"
                                   Appearance="Primary" HorizontalAlignment="Stretch"
                                   IsEnabled="{Binding CanStartProcessing}"/>
                        <ui:Button Content="取消" Command="{Binding CancelProcessingCommand}" 
                                   Margin="10,0,0,0" HorizontalAlignment="Stretch" Grid.Column="1"
                                   Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding StatusMessage}"/>
                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding ProcessingTime}"/>

                <ProgressBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                            Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"
                            Height="8" Margin="0,10,0,0"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>